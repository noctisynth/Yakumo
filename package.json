{
  "name": "yakumo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --workspace --locked",
    "test:accounts": "bun test scripts/accounts-store.test.ts",
    "check:versions": "bun scripts/check-versions.ts",
    "test:release": "bun test scripts/release-tools.test.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "verify": "bun run check && bun run check:versions && bun run typecheck:scripts && bun run test:release && bun run test:accounts && bun run build && bun run check:rust && bun run test:rust",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "2.12.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "1.57.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
