{
  "name": "yakumo",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --workspace --locked",
    "test:accounts": "bun test scripts/accounts-store.test.ts",
    "test:android-config": "bun test scripts/android-build-tools.test.ts",
    "test:dashboard": "bun test scripts/dashboard-store.test.ts",
    "check:versions": "bun scripts/check-versions.ts",
    "test:release": "bun test scripts/release-tools.test.ts",
    "test:updater": "bun test scripts/updater-tools.test.ts scripts/update-store.test.ts scripts/signing-backup.test.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "verify": "bun run check && bun run check:versions && bun run typecheck:scripts && bun run test:release && bun run test:android-config && bun run test:accounts && bun run test:dashboard && bun run test:studio && bun run test:map && bun run test:updater && bun run build && bun run check:rust && bun run test:rust",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:studio": "bun test scripts/studio-sampling.test.ts",
    "test:map": "bun test scripts/map-loading.test.ts"
  },
  "dependencies": {
    "@tauri-apps/plugin-updater": "file:vendor/updater",
    "@fontsource-variable/geist": "^5.3.0",
    "@stepperize/react": "^8.0.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-geolocation": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "1.57.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/bun": "1.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
